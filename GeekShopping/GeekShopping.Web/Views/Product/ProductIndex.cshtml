@model IEnumerable<ProductModel>

<br />
<br />
<div class="container p-4 border">
	<div class="row pb-2"> 
		<div class="col">
			<h1 class="text-primary">Products List</h1>
		</div>
		<div class="col text-end pt-1">
			<a asp-action="ProductCreate" class="btn btn-outline-primary"></a>
			<i></i>Create new Product
		</div>
	</div>
	<table class="table">
		<thead>
			<tr>
				<th>
					Name
				</th>
				<th>
					Category
				</th>
				<th>
					Price
				</th>
			</tr>	
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<th>
						@item.Name
					</th>
					<th>
						@item.CategoryName
					</th>
					<th>
						@item.Price
					</th>
				</tr>
			}
		</tbody>
	</table>
</div>